            columnWidth3=(135, 50, 150),
            changeCommand=self.update_existing_contours
        )

        # ★ 手描き風ノイズの「入れる / 入れない」切り替えボタン
        cmds.separator(height=4, style='none')
        cmds.text(label="【手描き風ノイズ（線のガタガタ・強弱）】", align='left', font="boldLabelFont")
        
        self.noise_toggle_layout = cmds.rowLayout(numberOfColumns=2, columnWidth2=(190, 190), columnAttach=[(1, 'both', 2), (2, 'both', 2)])
        self.noise_on_btn = cmds.button(
