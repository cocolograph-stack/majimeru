            label="Beauty(中身)から線を消し、専用AOVに輪郭線を分離する", 
            value=True,
            changeCommand=self.update_existing_contours
        )
        self.aov_name_field = cmds.textFieldGrp(
            label="輪郭線AOV名: ",
            text="toon_outline",
            columnWidth2=(135, 180)
        )
        self.merge_aov_cb = cmds.checkBox(
