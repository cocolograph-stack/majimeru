            value=True
        )

        cmds.separator(height=6, style='in')

        # --- 2. Contour (輪郭線・手描きノイズ) 設定 ---
        cmds.text(label="【2. 輪郭線 ＆ 手描き風ノイズ設定】", align='left', font="boldLabelFont")
