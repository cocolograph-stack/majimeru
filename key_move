import maya.cmds as cmds
import maya.OpenMayaUI as omui

try:
  from PySide6 import QtCore, QtGui, QtWidgets
  from shiboken6 import wrapInstance
except ImportError:
  from PySide2 import QtCore, QtGui, QtWidgets
  from shiboken2 import wrapInstance


def get_maya_window():
  ptr = omui.MQtUtil.mainWindow()
  if ptr is not None:
    return wrapInstance(int(ptr), QtWidgets.QWidget)
  return None


# キー移動と自動タンジェント最適化
def shift_selected_keys(time_offset, value_offset):
  curves = cmds.keyframe(q=True, sl=True, name=True)
  if not curves:
    return

  curves = list(set(curves))
  for curve in curves:
    times = cmds.keyframe(curve, q=True, sl=True, tc=True)
    if not times:
      continue

    sorted_times = sorted(times, reverse=(time_offset > 0))

    for t in sorted_times:
      current_vals = cmds.keyframe(
          curve, time=(t, t), q=True, valueChange=True
      )
      if not current_vals:
        continue
      v = current_vals[0]

      new_t = t + time_offset
      new_v = v + value_offset

      if time_offset != 0:
        cmds.keyframe(
            curve, time=(t, t), edit=True, timeChange=new_t, absolute=True
        )

      if value_offset != 0:
        target_t = new_t if time_offset != 0 else t
        cmds.keyframe(
            curve,
            time=(target_t, target_t),
            edit=True,
            valueChange=new_v,
            absolute=True,
        )

      final_t = new_t if time_offset != 0 else t
      cmds.keyTangent(curve, time=(final_t, final_t), itt='auto', ott='auto')


def scale_selected_keys(factor):
  curves = cmds.keyframe(q=True, sl=True, name=True)
  if not curves:
    return

  curves = list(set(curves))
  for curve in curves:
    times = cmds.keyframe(curve, q=True, sl=True, tc=True)
    if not times or len(times) < 2:
      continue

    base_time = times[0]
    sorted_times = sorted(times, reverse=(factor > 1.0))

    for t in sorted_times:
      if t == base_time:
        continue
      diff = t - base_time
      new_time = base_time + (diff * factor)
      new_time = round(new_time)

      cmds.keyframe(
          curve, time=(t, t), edit=True, timeChange=new_time, absolute=True
      )
      cmds.keyTangent(curve, time=(new_time, new_time), itt='auto', ott='auto')


# ★ 選択中のキーをブレイクダウンキーに確実に変換する処理
def convert_to_breakdown():
  curves = cmds.keyframe(q=True, sl=True, name=True)
  if not curves:
    cmds.warning(
        'グラフエディタ上でブレイクダウンに変換したいキーを選択してください。'
    )
    return

  curves = list(set(curves))
  count = 0

  for curve in curves:
    times = cmds.keyframe(curve, q=True, sl=True, tc=True)
    if not times:
      continue

    for t in times:
      # keyframeコマンドで直接ブレイクダウン属性（True）を書き込む
      cmds.keyframe(
          curve, time=(t, t), edit=True, breakdown=True
      )
      count += 1

  print(
      f'選択されたキー ({count}個) をブレイクダウンキーに変換しました。'
  )


# 押し続け対応のボタンクラス
class HoldButton(QtWidgets.QPushButton):

  def __init__(self, text, callback, parent=None):
    super(HoldButton, self).__init__(text, parent)
    self.callback = callback
    self.timer = QtCore.QTimer(self)
    self.timer.setInterval(70)
    self.timer.timeout.connect(self.callback)

  def mousePressEvent(self, event):
    super(HoldButton, self).mousePressEvent(event)
    self.callback()
    self.timer.start()

  def mouseReleaseEvent(self, event):
    super(HoldButton, self).mouseReleaseEvent(event)
    self.timer.stop()


