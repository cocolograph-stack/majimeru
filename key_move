    scale_btn_style = (
        'QPushButton { background-color: #5a4a63; color: white;'
        ' font-weight: bold; padding: 6px; border-radius: 12px; }'
        'QPushButton:hover { background-color: #6a5a73; }'
    )

    bd_btn_style = (
        'QPushButton { background-color: #3d6852; color: white;'
        ' font-weight: bold; padding: 6px; border-radius: 12px; }'
        'QPushButton:hover { background-color: #4c7d63; }'
    )

    # ブレイクダウン変換セクション
    layout.addWidget(QtWidgets.QLabel('<b>【 キーの属性変換 】</b>'))
    b_breakdown = QtWidgets.QPushButton('🟢 ブレイクダウンに変換 (Breakdown)')
    b_breakdown.setStyleSheet(bd_btn_style)
    b_breakdown.clicked.connect(convert_to_breakdown)
    layout.addWidget(b_breakdown)

    l0 = QtWidgets.QFrame()
    l0.setFrameShape(QtWidgets.QFrame.HLine)
    l0.setFrameShadow(QtWidgets.QFrame.Sunken)
    layout.addWidget(l0)

    # 1. 上下移動セクション (+1, +5, +10)
    layout.addWidget(
        QtWidgets.QLabel('<b>【 上下移動 (長押しで連続変化) 】</b>')
    )
    grid_val = QtWidgets.QGridLayout()

    # ±1
    b_up1 = HoldButton('▲ +1', lambda: shift_selected_keys(0, 1.0), self)
    b_dn1 = HoldButton('▼ -1', lambda: shift_selected_keys(0, -1.0), self)
    b_up1.setStyleSheet(btn_style)
    b_dn1.setStyleSheet(btn_style)
    grid_val.addWidget(b_up1, 0, 0)
    grid_val.addWidget(b_dn1, 0, 1)

    # ±5
    b_up5 = HoldButton('▲ +5', lambda: shift_selected_keys(0, 5.0), self)
    b_dn5 = HoldButton('▼ -5', lambda: shift_selected_keys(0, -5.0), self)
    b_up5.setStyleSheet(btn_style)
    b_dn5.setStyleSheet(btn_style)
    grid_val.addWidget(b_up5, 1, 0)
    grid_val.addWidget(b_dn5, 1, 1)

    # ±10
    b_up10 = HoldButton('▲ +10', lambda: shift_selected_keys(0, 10.0), self)
    b_dn10 = HoldButton('▼ -10', lambda: shift_selected_keys(0, -10.0), self)
    b_up10.setStyleSheet(btn_style)
    b_dn10.setStyleSheet(btn_style)
    grid_val.addWidget(b_up10, 2, 0)
    grid_val.addWidget(b_dn10, 2, 1)

    layout.addLayout(grid_val)

    l1 = QtWidgets.QFrame()
    l1.setFrameShape(QtWidgets.QFrame.HLine)
    l1.setFrameShadow(QtWidgets.QFrame.Sunken)
    layout.addWidget(l1)

    # 2. 左右移動セクション
    layout.addWidget(
        QtWidgets.QLabel('<b>【 左右移動 (フレーム単位) 】</b>')
    )
    grid_time = QtWidgets.QGridLayout()
    b_t_left = HoldButton('<< -1 F', lambda: shift_selected_keys(-1, 0), self)
    b_t_right = HoldButton('+1 F >>', lambda: shift_selected_keys(1, 0), self)
    b_t_left.setStyleSheet(btn_style)
    b_t_right.setStyleSheet(btn_style)
    grid_time.addWidget(b_t_left, 0, 0)
    grid_time.addWidget(b_t_right, 0, 1)
    layout.addLayout(grid_time)

    l2 = QtWidgets.QFrame()
    l2.setFrameShape(QtWidgets.QFrame.HLine)
    l2.setFrameShadow(QtWidgets.QFrame.Sunken)
    layout.addWidget(l2)

    # 3. 間隔の伸縮
    layout.addWidget(QtWidgets.QLabel('<b>【 キーの間隔詰め・広げ 】</b>'))
    grid_scale = QtWidgets.QGridLayout()
    b_s_in = QtWidgets.QPushButton('キュッと詰める (x0.8)')
    b_s_out = QtWidgets.QPushButton('グッと広げる (x1.2)')
    b_s_in.setStyleSheet(scale_btn_style)
    b_s_out.setStyleSheet(scale_btn_style)
    b_s_in.clicked.connect(lambda: scale_selected_keys(0.8))
    b_s_out.clicked.connect(lambda: scale_selected_keys(1.2))
    grid_scale.addWidget(b_s_in, 0, 0)
    grid_scale.addWidget(b_s_out, 0, 1)
    layout.addLayout(grid_scale)


