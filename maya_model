def open_mirror_dialog():
    win = "mirrorOptWin"
    close_win(win)
    cmds.window(win, title="ミラー (Mirror) 設定", widthHeight=(450, 190), sizeable=True)
    cmds.columnLayout(adjustableColumn=True, rowSpacing=15, columnAttach=("both", 20))
    cmds.text(label="", height=5)
    
    axis_menu = cmds.optionMenuGrp(label="ミラー軸 (Axis)", columnWidth2=(130, 150))
    cmds.menuItem(label="X")
    cmds.menuItem(label="Y")
    cmds.menuItem(label="Z")
    cmds.optionMenuGrp(axis_menu, edit=True, select=1)
    
    merge_chk = cmds.checkBox(label="境界をマージする (Merge Borders)", value=True)
    
    cmds.text(label="", height=5)
    def apply_mirror():
        targets = get_target_transforms()
        if targets:
            axis_idx = cmds.optionMenuGrp(axis_menu, query=True, select=True) - 1 # 0:X, 1:Y, 2:Z
            merge_val = cmds.checkBox(merge_chk, query=True, value=True)
            cmds.select(targets, replace=True)
            try:
                cmds.polyMirrorFace(mirrorAxis=axis_idx, mergeMode=1 if merge_val else 0, ch=True)
                print("ミラーを実行しました。")
            except Exception as e:
                cmds.warning(f"ミラーの実行に失敗しました: {e}")
        else:
            cmds.warning("オブジェクトを選択してください")
        cmds.deleteUI(win, window=True)

    cmds.button(label="実行 (Apply)", bgc=[0.3, 0.3, 0.5], height=38, command=lambda *args: apply_mirror())
    cmds.showWindow(win)


# --- ツール直接起動用関数 ---

def do_insert_edge_loop():
    mel.eval("InsertEdgeLoopTool;")

def do_multi_cut():
    mel.eval("dR_multiCutTool;")

def do_target_weld():
    mel.eval("dR_targetWeldTool;")

def do_combine():
    if len(cmds.ls(selection=True)) >= 2:
        cmds.polyUnite(ch=True)
        print("オブジェクトを結合しました。")
    else:
        cmds.warning("結合するには2つ以上のオブジェクトを選択してください")

def do_fill_hole():
    targets = get_target_transforms()
    if targets:
        cmds.select(targets, replace=True)
        mel.eval("polyCloseBorder;")
        print("穴を埋めました。")
    else:
        cmds.warning("オブジェクトまたはコンポーネントを選択してください")


# --- ヒストリー削除・フリーズの直接実行関数 ---

def do_history_delete():
    targets = get_target_transforms()
    if targets:
        cmds.select(targets, replace=True)
        mel.eval("delete -ch;")
        cmds.select(targets, replace=True)
        print("ヒストリーを削除しました。")
    else:
        cmds.warning("オブジェクトまたはコンポーネントを選択してください")

def do_freeze_transforms():
    targets = get_target_transforms()
    if targets:
        cmds.select(targets, replace=True)
        mel.eval("makeIdentity -apply true -t 1 -r 1 -s 1 -n 0 -pn 1;")
        cmds.select(targets, replace=True)
        print("トランスフォームをフリーズしました。")
    else:
        cmds.warning("オブジェクトまたはコンポーネントを選択してください")


