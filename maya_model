    cmds.button(label="11. ミラー (Mirror) ...", bgc=[0.3, 0.3, 0.5], height=32, command=lambda *args: open_mirror_dialog())
    
    cmds.separator(height=12, style="in")
    cmds.text(label="ユーティリティ", align="center", font="boldLabelFont")
    cmds.separator(height=10, style="in")
    
    cmds.button(label="12. ヒストリー削除", bgc=[0.3, 0.4, 0.5], height=32, command=lambda *args: do_history_delete())
    cmds.button(label="13. トランスフォームフリーズ", bgc=[0.3, 0.4, 0.5], height=32, command=lambda *args: do_freeze_transforms())
                
    cmds.showWindow(window)

create_modeling_toolbox()
