import maya.cmds as cmds
import maya.mel as mel

def close_win(win_name):
    if cmds.window(win_name, exists=True):
        cmds.deleteUI(win_name, window=True)

# --- 選択アイテム（コンポーネント含む）から親のトランスフォームノードを自動取得する関数 ---
def get_target_transforms():
    sel = cmds.ls(selection=True, long=True)
    if not sel:
        return []
    
    objects = cmds.ls(selection=True, objectsOnly=True, long=True)
    transforms = []
    for obj in objects:
        if cmds.nodeType(obj) == 'transform':
            transforms.append(obj)
        else:
            p = cmds.listRelatives(obj, parent=True, fullPath=True, type='transform')
            if p:
                transforms.append(p[0])
    
    return list(set(transforms))

# --- 各ツールの設定・実行ウィンドウ ---

def open_extrude_dialog():
    win = "extrudeOptWin"
    close_win(win)
    cmds.window(win, title="押し出し (Extrude) 設定", widthHeight=(750, 200), sizeable=True)
    cmds.columnLayout(adjustableColumn=True, rowSpacing=15, columnAttach=("both", 20))
    cmds.text(label="", height=5)
    
    thick_field = cmds.floatSliderGrp(label="厚み (Thickness)", field=True, value=0.0, min=-5.0, max=5.0, precision=3, adjustableColumn=2, columnWidth3=(160, 100, 90))
    div_field = cmds.intSliderGrp(label="分割数 (Divisions)", field=True, value=1, min=1, max=20, adjustableColumn=2, columnWidth3=(160, 100, 90))
    
    cmds.text(label="", height=5)
    cmds.button(label="実行 (Apply)", bgc=[0.2, 0.5, 0.3], height=40,
                command=lambda *args: (
                    cmds.polyExtrudeFacet(
                        thickness=cmds.floatSliderGrp(thick_field, query=True, value=True),
                        divisions=cmds.intSliderGrp(div_field, query=True, value=True)
                    ) if cmds.ls(selection=True) else cmds.warning("フェースを選択してください"),
                    cmds.deleteUI(win, window=True)
                ))
    cmds.showWindow(win)

