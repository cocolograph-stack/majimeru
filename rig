import maya.cmds as cmds

def makeFKTR(*args):
    selection = cmds.ls(sl=True)
    size = len(selection)
    
    if size == 0:
        cmds.error("Please select one or more objects to control.")
        
    if size == 1:
        descendants = cmds.listRelatives(selection[0], allDescendents=True, fullPath=False)
        if descendants:
            descendants.reverse()
            selection = selection + descendants
        size = len(selection)
        
    controlSize = cmds.floatSliderGrp("controlSize", q=True, v=True)
    controlPref = cmds.textFieldGrp("controlPrefix", q=True, text=True)
    controlSuff = cmds.textFieldGrp("controlName", q=True, text=True)
    
    rgbColor = cmds.colorSliderGrp("controlColorRGB", q=True, rgb=True)

    for i in range(size):
        base_name = selection[i].replace("_JNT", "").replace("_jnt", "")
        full_name = controlPref + base_name + controlSuff
        if cmds.objExists(full_name):
            cmds.error("Please enter a unique name combination.")
            
    for i in range(size):
        base_name = selection[i].replace("_JNT", "").replace("_jnt", "")
        
        cube = cmds.curve(d=1, p=[
            (-0.5, 0.5, 0.5), (0.5, 0.5, 0.5), (0.5, 0.5, -0.5), (-0.5, 0.5, -0.5), (-0.5, 0.5, 0.5),
            (-0.5, -0.5, 0.5), (0.5, -0.5, 0.5), (0.5, -0.5, -0.5), (-0.5, -0.5, -0.5), (-0.5, -0.5, 0.5),
            (0.5, -0.5, 0.5), (0.5, 0.5, 0.5), (0.5, 0.5, -0.5), (0.5, -0.5, -0.5), (-0.5, -0.5, -0.5),
            (-0.5, -0.5, -0.5), (-0.5, 0.5, -0.5), (-0.5, 0.5, 0.5)
        ])
        cubeShape = cmds.pickWalk(d="down")
        
        cmds.setAttr(cubeShape[0] + ".overrideEnabled", 1)
        cmds.setAttr(cubeShape[0] + ".overrideRGBColors", 1)
        cmds.setAttr(cubeShape[0] + ".overrideColorRGB", rgbColor[0], rgbColor[1], rgbColor[2])
        
        ctrl_name = cmds.rename(cube, controlPref + base_name + controlSuff)
        cmds.select(ctrl_name)
        cmds.scale(controlSize, controlSize, controlSize, r=True)
        cmds.makeIdentity(apply=True, t=1, r=1, s=1, n=0)
        
        offset_name = cmds.group(em=True, n=controlPref + base_name + "_offset")
        temp_orient = cmds.orientConstraint(selection[i], offset_name)
        cmds.delete(temp_orient)
        temp_point = cmds.pointConstraint(selection[i], offset_name)
        cmds.delete(temp_point)

        cmds.parent(ctrl_name, offset_name)
        
        for attr in [".tx", ".ty", ".tz", ".rx", ".ry", ".rz"]:
            cmds.setAttr(ctrl_name + attr, 0)
            
        cmds.parentConstraint(ctrl_name, selection[i], mo=True)
        
    selectionParent = "noParent"
    for i in range(size):
        parent = cmds.listRelatives(selection[i], parent=True)
        if parent and len(parent) > 0:
            parentCheck = parent[0]
            if parentCheck not in selection:
                selectionParent = parentCheck
                
    if selectionParent != "noParent":
        base_first = selection[0].replace("_JNT", "").replace("_jnt", "")
        cmds.parentConstraint(selectionParent, controlPref + base_first + "_offset", mo=True)


def makeIKTR(*args):
    selection = cmds.ls(sl=True)
    if len(selection) != 2:
        cmds.error("Please select exactly 2 joints (Start joint and End joint).")
        
    start_joint = selection[0]
    end_joint = selection[1]
    base_end_joint = end_joint.replace("_JNT", "").replace("_jnt", "")
    
    controlSize = cmds.floatSliderGrp("controlSize", q=True, v=True)
    controlPref = cmds.textFieldGrp("controlPrefix", q=True, text=True)
    controlSuff = cmds.textFieldGrp("controlName", q=True, text=True)
    rgbColor = cmds.colorSliderGrp("controlColorRGB", q=True, rgb=True)
    
    cube = cmds.curve(d=1, p=[
        (-0.5, 0.5, 0.5), (0.5, 0.5, 0.5), (0.5, 0.5, -0.5), (-0.5, 0.5, -0.5), (-0.5, 0.5, 0.5),
        (-0.5, -0.5, 0.5), (0.5, -0.5, 0.5), (0.5, -0.5, -0.5), (-0.5, -0.5, -0.5), (-0.5, -0.5, 0.5),
        (0.5, -0.5, 0.5), (0.5, 0.5, 0.5), (0.5, 0.5, -0.5), (0.5, -0.5, -0.5), (-0.5, -0.5, -0.5),
        (-0.5, -0.5, -0.5), (-0.5, 0.5, -0.5), (-0.5, 0.5, 0.5)
    ])
    cubeShape = cmds.pickWalk(d="down")
    
    cmds.setAttr(cubeShape[0] + ".overrideEnabled", 1)
    cmds.setAttr(cubeShape[0] + ".overrideRGBColors", 1)
    cmds.setAttr(cubeShape[0] + ".overrideColorRGB", rgbColor[0], rgbColor[1], rgbColor[2])
    
    ctrl_name = cmds.rename(cube, controlPref + base_end_joint + controlSuff)
    cmds.select(ctrl_name)
    cmds.scale(controlSize, controlSize, controlSize, r=True)
    cmds.makeIdentity(apply=True, t=1, r=1, s=1, n=0)
    
    offset_name = cmds.group(em=True, n=controlPref + base_end_joint + "_offset")
    temp_orient = cmds.orientConstraint(end_joint, offset_name)
    cmds.delete(temp_orient)
    temp_point = cmds.pointConstraint(end_joint, offset_name)
    cmds.delete(temp_point)

    cmds.parent(ctrl_name, offset_name)
    
    for attr in [".tx", ".ty", ".tz", ".rx", ".ry", ".rz"]:
        cmds.setAttr(ctrl_name + attr, 0)
        
    ik_handle, ik_effector = cmds.ikHandle(
        startJoint=start_joint,
        endEffector=end_joint,
        sol="ikRPsolver"
    )
    ik_handle_name = cmds.rename(ik_handle, start_joint + "_ikHandle")
    cmds.parent(ik_handle_name, ctrl_name)


def makeMeshFitCtrl(*args):
    sel = cmds.ls(sl=True, flatten=True)
    if not sel:
        cmds.error("Please select a model, object, or vertices to fit the controller.")
        
    bbox = cmds.xform(sel, q=True, ws=True, boundingBox=True)
    if not bbox:
        cmds.error("Could not calculate bounding box from selection.")
        
    center_x = (bbox[0] + bbox[3]) / 2.0
    center_y = (bbox[1] + bbox[4]) / 2.0
    center_z = (bbox[2] + bbox[5]) / 2.0
    
    size_x = max(bbox[3] - bbox[0], 0.1)
    size_y = max(bbox[4] - bbox[1], 0.1)
    size_z = max(bbox[5] - bbox[2], 0.1)

    controlSize = cmds.floatSliderGrp("controlSize", q=True, v=True)
    controlPref = cmds.textFieldGrp("controlPrefix", q=True, text=True)
    controlSuff = cmds.textFieldGrp("controlName", q=True, text=True)
    rgbColor = cmds.colorSliderGrp("controlColorRGB", q=True, rgb=True)
    
    base_name = cmds.ls(sel[0], o=True)[0]
    if "." in base_name:
        base_name = base_name.split(".")[0]

    cube = cmds.curve(d=1, p=[
        (-0.5, 0.5, 0.5), (0.5, 0.5, 0.5), (0.5, 0.5, -0.5), (-0.5, 0.5, -0.5), (-0.5, 0.5, 0.5),
        (-0.5, -0.5, 0.5), (0.5, -0.5, 0.5), (0.5, -0.5, -0.5), (-0.5, -0.5, -0.5), (-0.5, -0.5, 0.5),
        (0.5, -0.5, 0.5), (0.5, 0.5, 0.5), (0.5, 0.5, -0.5), (0.5, -0.5, -0.5), (-0.5, -0.5, -0.5),
        (-0.5, -0.5, -0.5), (-0.5, 0.5, -0.5), (-0.5, 0.5, 0.5)
    ])
    cubeShape = cmds.pickWalk(d="down")
    
    cmds.setAttr(cubeShape[0] + ".overrideEnabled", 1)
    cmds.setAttr(cubeShape[0] + ".overrideRGBColors", 1)
    cmds.setAttr(cubeShape[0] + ".overrideColorRGB", rgbColor[0], rgbColor[1], rgbColor[2])
    
    ctrl_name = cmds.rename(cube, controlPref + base_name + "_Fit" + controlSuff)
    cmds.select(ctrl_name)
    
    cmds.scale(size_x * controlSize, size_y * controlSize, size_z * controlSize, r=True)
    cmds.makeIdentity(apply=True, t=1, r=1, s=1, n=0)
    
    offset_name = cmds.group(em=True, n=controlPref + base_name + "_Fit_offset")
    cmds.xform(offset_name, ws=True, t=(center_x, center_y, center_z))

    cmds.parent(ctrl_name, offset_name)
    
    for attr in [".tx", ".ty", ".tz", ".rx", ".ry", ".rz"]:
        cmds.setAttr(ctrl_name + attr, 0)


def applyColorPreset(*args):
    preset_name = cmds.optionMenuGrp("colorPresetMenu", q=True, value=True)
    
    color_dict = {
        "Blue (Left / Male)": (0.2, 0.6, 1.0),
        "Pink / Light Blue (Right)": (1.0, 0.5, 0.8),
        "Red (Center/Main)": (1.0, 0.2, 0.2),
        "Yellow (Sub/IK)": (1.0, 0.9, 0.2),
        "Green (Aux)": (0.2, 0.8, 0.4),
        "White": (1.0, 1.0, 1.0),
        "Black / Dark Gray": (0.2, 0.2, 0.2)
    }
    
    if preset_name in color_dict:
        rgb = color_dict[preset_name]
        cmds.colorSliderGrp("controlColorRGB", e=True, rgb=rgb)


def applyColorToSelected(*args):
    selection = cmds.ls(sl=True, long=True)
    if not selection:
        cmds.error("Please select one or more objects to apply color.")
        
    rgbColor = cmds.colorSliderGrp("applyColorRGB", q=True, rgb=True)
    
    for obj in selection:
        shapes = cmds.listRelatives(obj, shapes=True, fullPath=True)
        if not shapes:
            if cmds.nodeType(obj) in ['nurbsCurve', 'mesh', 'joint']:
                shapes = [obj]
            else:
                continue
                
        for shape in shapes:
            cmds.setAttr(shape + ".overrideEnabled", 1)
            cmds.setAttr(shape + ".overrideRGBColors", 1)
            cmds.setAttr(shape + ".overrideColorRGB", rgbColor[0], rgbColor[1], rgbColor[2])


def renameJoints(*args):
    selection = cmds.ls(sl=True)
    if not selection:
        cmds.error("Please select joints to rename.")
        
    selected_name = cmds.optionMenuGrp("renamePresetMenu", q=True, value=True)
    controlPref = cmds.textFieldGrp("controlPrefix", q=True, text=True)
    
    if len(selection) == 1:
        new_name = controlPref + selected_name + "_JNT"
        cmds.rename(selection[0], new_name)
    else:
        for i, obj in enumerate(selection):
            new_name = controlPref + selected_name + "_" + str(i+1).zfill(2) + "_JNT"
            cmds.rename(obj, new_name)


def renameFingerJoints(*args):
    selection = cmds.ls(sl=True, long=True)
    if not selection:
        cmds.error("Please select the root joint of the finger.")
        
    finger_name = cmds.optionMenuGrp("fingerPresetMenu", q=True, value=True)
    controlPref = cmds.textFieldGrp("controlPrefix", q=True, text=True)
    
    for sel in selection:
        chain = [sel]
        current = sel
        while True:
            children = cmds.listRelatives(current, children=True, type='joint', fullPath=True)
            if children and len(children) > 0:
                current = children[0]
                chain.append(current)
            else:
                break
        
        rename_pairs = [(obj, i) for i, obj in enumerate(chain)]
        rename_pairs.reverse()
        
        for obj, i in rename_pairs:
            new_name = controlPref + finger_name + "_" + str(i+1).zfill(2) + "_JNT"
            cmds.rename(obj, new_name)


