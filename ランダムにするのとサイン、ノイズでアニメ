import random
import maya.cmds as cmds


def update_attribute_menu(*args):
  selection = cmds.ls(sl=True)
  if not selection:
    cmds.warning(
        'オブジェクトが選択されていません。対象を1つ以上選択してください。'
    )
    return

  target = selection[0]
  targets = [target]
  shapes = cmds.listRelatives(target, shapes=True, fullPath=True)
  if shapes:
    targets.extend(shapes)

  all_attrs = []
  for t in targets:
    attrs = cmds.listAttr(t, scalar=True) or []
    for attr in attrs:
      if attr not in all_attrs:
        full_attr = f'{t}.{attr}'
        try:
          if cmds.getAttr(full_attr, type=True) in [
              'float',
              'double',
              'doubleAngle',
              'doubleLinear',
              'long',
              'short',
              'byte',
          ]:
            all_attrs.append(attr)
        except Exception:
          pass

  all_attrs = sorted(list(set(all_attrs)))

  menu_items = cmds.optionMenu(attr_menu, query=True, ill=True)
  if menu_items:
    cmds.deleteUI(menu_items)

  if all_attrs:
    for attr in all_attrs:
      cmds.menuItem(label=attr, parent=attr_menu)
    print(
        f'成功: 「{target}」から {len(all_attrs)} 個のアトリビュートを読み込みました。'
    )
  else:
    cmds.menuItem(label='取得できるアトリビュートがありません', parent=attr_menu)


def randomize_attribute(*args):
  attr_name = cmds.optionMenu(attr_menu, query=True, value=True)
  if attr_name.startswith('(') or not attr_name:
    cmds.warning('有効なアトリビュートが選択されていません。')
    return

  min_val = cmds.floatFieldGrp(min_field, query=True, value1=True)
  max_val = cmds.floatFieldGrp(max_field, query=True, value1=True)

  selection = cmds.ls(sl=True)
  if not selection:
    cmds.warning('オブジェクトが選択されていません。')
    return

  success_count = 0
  for obj in selection:
    targets = [obj]
    shapes = cmds.listRelatives(obj, shapes=True, fullPath=True)
    if shapes:
      targets.extend(shapes)

    attr_found = False
    for target in targets:
      full_attr = f'{target}.{attr_name}'
      if cmds.objExists(full_attr):
        try:
          if not cmds.getAttr(full_attr, lock=True):
            # 静的なランダム化の前に、古いエクスプレッションがあれば削除しておく
            connected_expr = cmds.listConnections(full_attr, type='expression')
            if connected_expr:
              cmds.delete(connected_expr)

            val = random.uniform(min_val, max_val)
            cmds.setAttr(full_attr, val)
            attr_found = True
        except Exception:
          pass
    if attr_found:
      success_count += 1

  print(
      f'完了: {success_count} 個の対象でアトリビュート「{attr_name}」を'
      f' [{min_val} 〜 {max_val}] でランダム化しました。'
  )


def apply_wave_expression(wave_type, *args):
  attr_name = cmds.optionMenu(attr_menu, query=True, value=True)
  if attr_name.startswith('(') or not attr_name:
    cmds.warning('有効なアトリビュートが選択されていません。')
    return

  min_val = cmds.floatFieldGrp(min_field, query=True, value1=True)
  max_val = cmds.floatFieldGrp(max_field, query=True, value1=True)
  speed = cmds.floatFieldGrp(speed_field, query=True, value1=True)

  center = (min_val + max_val) / 2.0
  amplitude = (max_val - min_val) / 2.0

  selection = cmds.ls(sl=True)
  if not selection:
    cmds.warning('オブジェクトが選択されていません。')
    return

  success_count = 0
  for i, obj in enumerate(selection):
    targets = [obj]
    shapes = cmds.listRelatives(obj, shapes=True, fullPath=True)
    if shapes:
      targets.extend(shapes)

    attr_found = False
    for target in targets:
      full_attr = f'{target}.{attr_name}'
      if cmds.objExists(full_attr):
        try:
          if not cmds.getAttr(full_attr, lock=True):
            # 【重要】すでにこのアトリビュートに繋がっている古いエクスプレッションをすべて削除する
            connected_expr = cmds.listConnections(full_attr, type='expression')
            if connected_expr:
              cmds.delete(connected_expr)

            phase = i * 0.7

            if wave_type == 'sine':
              base_freq = 3.0 * speed
              expr_str = (
                  f'{full_attr} = sin(time * {base_freq} + {phase}) *'
                  f' {amplitude} + {center};'
              )
            elif wave_type == 'noise':
              base_freq = 1.5 * speed
              expr_str = (
                  f'{full_attr} = noise(time * {base_freq} + {phase}) *'
                  f' {amplitude} + {center};'
              )

            expr_name = f'{target}_{attr_name}_{wave_type}Expr'
            cmds.expression(string=expr_str, name=expr_name, object=full_attr)
            attr_found = True
        except Exception:
          pass
    if attr_found:
      success_count += 1

  print(
      f'完了: {success_count} 個の対象に [{wave_type}] エクスプレッションを設定しました。'
      f' (範囲: {min_val}〜{max_val} / 速度: {speed})'
  )


# 既存のウィンドウがあれば閉じる
window_name = 'randomAttrToolWindow'
if cmds.window(window_name, exists=True):
  cmds.deleteUI(window_name)

# UIの構築
win = cmds.window(
    window_name,
    title='アトリビュート制御ツール（ランダム＆アニメーション）',
    widthHeight=(340, 360),
    resizeToFitChildren=True,
)
cmds.columnLayout(
    adjustableColumn=True, rowSpacing=10, columnAttach=('both', 12)
)

cmds.text(
    label=(
        '1. オブジェクトを選んで「アトリビュートを取得」\n2. 項目・Min/Max・速度を決める\n3.'
        ' 実行ボタンを押す！'
    ),
    align='left',
)

# アトリビュート取得ボタン
cmds.button(
    label='👇 選択したオブジェクトからアトリビュートを読み込む',
    backgroundColor=[0.4, 0.4, 0.4],
    height=28,
    command=update_attribute_menu,
)

# プルダウンメニュー
cmds.rowLayout(
    numberOfColumns=2, columnWidth2=(110, 180), columnAttach=[(1, 'right', 5)]
)
cmds.text(label='アトリビュート名:')
attr_menu = cmds.optionMenu(width=180)
cmds.menuItem(label='(ここに自動でリストが入ります)')
cmds.setParent('..')

min_field = cmds.floatFieldGrp(
    label='最小値 (Min)', value1=1.0, columnWidth=[(1, 110), (2, 180)]
)
max_field = cmds.floatFieldGrp(
    label='最大値 (Max)', value1=20.0, columnWidth=[(1, 110), (2, 180)]
)

# 速度設定欄
speed_field = cmds.floatFieldGrp(
    label='アニメーション速度', value1=1.0, columnWidth=[(1, 110), (2, 180)]
)

# 各種実行ボタン
cmds.button(
    label='🎲 一括ランダム化を実行（静的）',
    backgroundColor=[0.2, 0.5, 0.8],
    height=32,
    command=randomize_attribute,
)

cmds.button(
    label='🌊 サイン波でアニメーションさせる',
    backgroundColor=[0.2, 0.6, 0.4],
    height=32,
    command=lambda *args: apply_wave_expression('sine', *args),
)

cmds.button(
    label='🌀 ノイズ関数でアニメーションさせる',
    backgroundColor=[0.6, 0.4, 0.2],
    height=32,
    command=lambda *args: apply_wave_expression('noise', *args),
)

cmds.showWindow(win)
